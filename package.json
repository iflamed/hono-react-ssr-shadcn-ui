{
  "name": "hono-react-ssr",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "echo \"export default false\" > ./src/config/is_prod.ts && vite",
    "build": "$npm_execpath run version && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "deploy": "$npm_execpath run build && $npm_execpath run db:migrate:remote && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "version": "echo \"export default `date +'%s'`\" > ./src/config/build_time.ts && echo \"export default true\" > ./src/config/is_prod.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@date-fns/utc": "^2.1.1",
    "@hono/react-renderer": "^1.0.1",
    "@sindresorhus/slugify": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "hono": "^4.13.8",
    "iso-639-1": "^3.1.6",
    "lucide-react": "^1.46.0",
    "markdown-it": "^15.0.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-share": "^5.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.6.0",
    "drizzle-kit": "^1.0.0-rc.5-ab785fc",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.0.2",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-preserve-directives": "^1.1.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.56.0"
  }
}
