{
  "name": "hono-react-ssr",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "echo \"export default false\" > ./src/config/is_prod.ts && SERVER_MODE=local vite",
    "client": "SERVER_MODE=local vite --mode client",
    "build": "$npm_execpath run version && vite build --mode client && cp -f ./dist/client/.vite/manifest.json ./src/lib/manifest.json && vite build --mode server",
    "typecheck": "tsc --noEmit",
    "preview": "node dist/server/index.js",
    "migrate": "drizzle-kit generate && drizzle-kit migrate",
    "deploy": "$npm_execpath run deploy:caitun && $npm_execpath run deploy:ruobiyi",
    "deploy:caitun": "SERVER_MODE=caitun $npm_execpath run build && sh ./deploy.sh -c",
    "deploy:ruobiyi": "SERVER_MODE=ruobiyi $npm_execpath run build && sh ./deploy.sh -r",
    "version": "echo \"export default `date +'%s'`\" > ./src/config/build_time.ts && echo \"export default true\" > ./src/config/is_prod.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@date-fns/utc": "^2.1.1",
    "@hono/node-server": "^2.1.1",
    "@hono/react-renderer": "^1.0.1",
    "@sindresorhus/slugify": "^3.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.8",
    "iso-639-1": "^3.1.6",
    "lucide-react": "^1.46.0",
    "markdown-it": "^15.0.2",
    "mysql2": "^3.24.4",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-share": "^5.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.1",
    "autoprefixer": "^10.6.0",
    "drizzle-kit": "1.0.0-rc.4",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.0.2",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rollup-preserve-directives": "^1.1.3",
    "tailwindcss": "^4.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
